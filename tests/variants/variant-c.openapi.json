{
 "openapi": "3.0.3",
 "info": {
  "title": "Nordbank arrears tools (development fixture)",
  "version": "0.1"
 },
 "servers": [
  {
   "url": "https://example.invalid/nordbank/v2"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "question": {
          "type": "string",
          "enum": [
           "postcode",
           "birth_year"
          ]
         },
         "value": {
          "type": "string",
          "description": "postcode: capitals, no spaces. birth_year: four digits."
         }
        },
        "required": [
         "customer_id",
         "question",
         "value"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "match": {
           "type": "boolean"
          },
          "passed": {
           "type": "boolean",
           "description": "true when both questions are passed"
          },
          "attempts_left": {
           "type": "integer"
          },
          "hint": {
           "type": "string",
           "enum": [
            "spell_it"
           ]
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The overdue products. Refused until security is passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "ref": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "store_card",
               "consumer_loan",
               "overdraft"
              ]
             },
             "card_digits": {
              "type": "string",
              "description": "store cards only"
             },
             "overdue_amount": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             },
             "min_due": {
              "type": "number",
              "description": "store cards only"
             },
             "instalment": {
              "type": "number",
              "description": "consumer loans only"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a promise to pay.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_ref": {
          "type": "string"
         },
         "promise_amount": {
          "type": "number"
         },
         "pay_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "product_ref",
         "promise_amount",
         "pay_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_ref": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a product ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_ref": {
          "type": "string"
         },
         "code": {
          "type": "string",
          "enum": [
           "declined",
           "vulnerable",
           "contested",
           "already_paid",
           "system_fault"
          ]
         },
         "comment": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "product_ref",
         "code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a call-back.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "day": {
          "type": "string",
          "format": "date"
         },
         "slot": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "customer_id",
         "day",
         "slot"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a team.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "team": {
          "type": "string",
          "enum": [
           "debt_advice",
           "agent",
           "care"
          ]
         }
        },
        "required": [
         "customer_id",
         "team"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "ptp",
           "settled",
           "handover",
           "no_ptp",
           "id_fail",
           "no_contact"
          ]
         },
         "detail": {
          "type": "string",
          "description": "Required for every result except ptp and settled."
         }
        },
        "required": [
         "customer_id",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`done` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "done": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded."
     }
    }
   }
  }
 }
}