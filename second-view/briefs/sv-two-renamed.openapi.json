  "paths": {
    "/authenticate_member": {
      "post": {
        "operationId": "authenticate_member",
        "summary": "verify_identity; success ONLY when result.state equals ACCEPTED. All fields are inside request; member_token carries customer_id.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "member_token": {
                    "type": "string",
                    "description": "The call variable customer_id; identifies the synthetic session"
                  },
                  "request": {
                    "type": "object",
                    "properties": {
                      "challenge": {
                        "type": "string",
                        "enum": [
                          "membership_word",
                          "postal_code",
                          "birth_year"
                        ]
                      },
                      "response_text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "challenge",
                      "response_text"
                    ]
                  }
                },
                "required": [
                  "member_token",
                  "request"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envelope. REJECTED means no mutation occurred. Identity failures are per challenge.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "ACCEPTED",
                            "REJECTED"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "challenge_passed": {
                          "type": "boolean"
                        },
                        "fully_authenticated": {
                          "type": "boolean"
                        },
                        "remaining_for_challenge": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "challenge_passed",
                        "fully_authenticated",
                        "remaining_for_challenge"
                      ]
                    }
                  },
                  "required": [
                    "result",
                    "payload"
                  ]
                }
              }
            }
          }
        }
      }
    },
